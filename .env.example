# Optional Gemini provider. Get a free-tier friendly Gemini API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI-compatible AI provider.
# For OpenAI, keep OPENAI_BASE_URL as https://api.openai.com/v1.
# For OpenRouter free models, use an OpenRouter key, set the base URL below,
# and pick a current ":free" model from https://openrouter.ai/models?max_price=0.
# Example free model on 2026-09-20: inclusionai/ling-3.0-flash-vl:free
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PROVIDER_NAME=OpenAI

# OpenRouter example:
# OPENAI_API_KEY=your_openrouter_api_key_here
# OPENAI_MODEL=inclusionai/ling-3.0-flash-vl:free
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_PROVIDER_NAME=OpenRouter

# Groq example (configure these on the Render backend, then redeploy):
# OPENAI_API_KEY=your_groq_api_key_here
# OPENAI_MODEL=openai/gpt-oss-120b
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_PROVIDER_NAME=Groq

# Official university website to crawl and trust.
OFFICIAL_SITE_URL=https://gonouniversity.edu.bd/

# API/admin settings.
PORT=8787
ADMIN_TOKEN=change_this_for_production
RATE_LIMIT=50
RATE_WINDOW_MS=60000
MAX_REQUEST_BYTES=1048576
MAX_ATTACHMENT_BYTES=8388608

# Crawler settings.
MAX_PAGES=2500
MAX_PDFS=120
CRAWL_CONCURRENCY=6
PDF_CONCURRENCY=3
FETCH_TIMEOUT_MS=12000
FETCH_RETRIES=2
RECOVERY_PAGES=120

# Optional local fallback if Ollama is installed.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
