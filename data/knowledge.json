    {
      "url": "https://gonouniversity.edu.bd/mpbme/ug-programme/academic-policies-rules/",
      "title": "Academic Policies & Rules - Department of Medical Physics and Biomedical Engineering",
      "department": "Department of Medical Physics and Biomedical Engineering",
      "type": "academic",
      "publishedAt": "",
