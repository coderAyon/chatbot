      "url": "https://gonouniversity.edu.bd/law/message/message-from-hod/",
      "title": "Md. Monjurul Islam - Department of Law",
      "department": "Department of Law",
      "type": "general",
      "publishedAt": "",
      "modifiedAt": "2026-04-29T09:30:37+00:00",
      "headings": [
        "Department of Law",
        "Md. Monjurul Islam",
        "Other Posts",
