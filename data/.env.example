# Optional OpenAI-compatible AI provider.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.0-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Gemini provider. Get a free Gemini API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Official university website to crawl and trust.
OFFICIAL_SITE_URL=https://gonouniversity.edu.bd/

# API/admin settings.
PORT=8787
ADMIN_TOKEN=change_this_for_production
RATE_LIMIT=50
RATE_WINDOW_MS=60000
MAX_REQUEST_BYTES=1048576
MAX_ATTACHMENT_BYTES=8388608

# Crawler settings.
MAX_PAGES=900
MAX_PDFS=80
CRAWL_CONCURRENCY=10

# Optional. Free-tier friendly, fast Gemini model.
GEMINI_MODEL=gemini-2.5-flash

# Optional local fallback if Ollama is installed.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
